# =============================================================
# Lumagen A.I — environment variables
#
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's gitignored.
# =============================================================

# Public site URL — used in OG images, sitemap, canonical links.
# Override in Vercel for the production env.
NEXT_PUBLIC_SITE_URL="https://lumagen.ai"

# Supabase — provision at https://supabase.com (Pro tier recommended from day 1).
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Service-role key — server-only, never expose to the browser.
# Used by scripts/migrate-assets.ts and admin actions.
SUPABASE_SERVICE_ROLE_KEY=""

# Resend (transactional email) — Phase 5.
# Provision at https://resend.com
RESEND_API_KEY=""
RESEND_FROM="hello@lumagen.ai"

# Optional: Posthog (Phase 6 analytics)
# NEXT_PUBLIC_POSTHOG_KEY=""
# NEXT_PUBLIC_POSTHOG_HOST="https://eu.posthog.com"

# Optional: Sentry (Phase 6 error tracking)
# SENTRY_DSN=""
# SENTRY_AUTH_TOKEN=""
